---
import { Image } from 'astro:assets';
import mascote from '../assets/mascote.png';
import downloadedPhotos from '../data/offer-photos.manifest.json';

// Usa as mesmas fotos de exemplo das ofertas (baixadas no build); sem foto, mostra o nome do produto.
const photoFor = (offerId: string) =>
  (downloadedPhotos as Record<string, { src: string }>)[offerId]?.src ?? '';

// Mensagens de exemplo no formato do grupo, usando as ofertas reais de src/data/offers.ts.
const messages = [
  {
    intro: 'Preço farejado!',
    produto: 'Fone de Ouvido Pulse TWS Bluetooth 5.3',
    foto: photoFor('oferta-1'),
    de: 'R$ 149,90',
    por: 'R$ 73,21',
    link: 'farofi.no/fone',
    hora: '09:12',
  },
  {
    intro: 'Pista quente: esse aqui não dura até amanhã.',
    produto: 'Jogo de Panelas Inox 5 Peças Wincy',
    foto: photoFor('oferta-3'),
    de: 'R$ 396,86',
    por: 'R$ 242,00',
    link: 'farofi.no/panelas',
    hora: '12:47',
  },
];
---

<div class="phone-wrap">
  <figure class="phone" data-chat data-tilt>
    <figcaption class="sr-only">Exemplo de como as ofertas chegam no grupo do WhatsApp</figcaption>
    <div class="phone__screen" aria-hidden="true">
      <div class="chat__top">
        <span class="chat__back">‹</span>
        <span class="chat__avatar">
          <Image src={mascote} alt="" widths={[40, 80]} sizes="40px" loading="lazy" />
        </span>
        <span class="chat__who">
          <strong>FaroFino Ofertas</strong>
          <small data-chat-status>grupo · só o FaroFino envia mensagens</small>
        </span>
      </div>

      <div class="chat__body">
        <span class="chat__day">Hoje</span>
        {
          messages.map((m) => (
            <div class="bubble" data-bubble>
              <span class="bubble__name">FaroFino</span>
              {m.foto ? (
                <img class="bubble__photo bubble__photo--img" src={m.foto} alt="" width="480" height="480" loading="lazy" decoding="async" />
              ) : (
                <span class="bubble__photo">{m.produto}</span>
              )}
              <p class="bubble__text">
                <strong>{m.intro}</strong>
                <br />
                {m.produto}
                <br />
                <s>De {m.de}</s>
                <br />
                <b class="bubble__price">Por {m.por}</b>
                <br />
                <span class="bubble__link">{m.link}</span>
              </p>
              <span class="bubble__time">{m.hora}</span>
            </div>
          ))
        }
        <div class="bubble bubble--short" data-bubble>
          <span class="bubble__name">FaroFino</span>
          {
            photoFor('oferta-2') && (
              <img
                class="bubble__thumb"
                src={photoFor('oferta-2')}
                alt=""
                width="480"
                height="480"
                loading="lazy"
                decoding="async"
              />
            )
          }
          <p class="bubble__text">
            Garrafa térmica Invicta 1 litro caiu de <s>R$ 220,90</s> pra <b class="bubble__price">R$ 126,42</b>.
            Farejei, conferi, mandei.
            <br />
            <span class="bubble__link">farofi.no/garrafa</span>
          </p>
          <span class="bubble__time">18:05</span>
        </div>
        <div class="typing" data-typing hidden>
          <span></span><span></span><span></span>
        </div>
      </div>

      <div class="chat__footer">Somente o FaroFino pode enviar mensagens</div>
    </div>
  </figure>
  <button type="button" class="chat__replay" data-chat-replay hidden>Ver as mensagens chegando de novo</button>
</div>
