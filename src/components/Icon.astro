---
// Ícones de linha (Lucide). Recebe o SVG em texto e aplica tamanho/traço.
interface Props {
  svg: string;
  size?: number;
  class?: string;
}
const { svg, size = 24, class: className } = Astro.props;
const html = svg
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/class="[^"]*"/, `class="icon ${className ?? ''}" aria-hidden="true" focusable="false"`)
  .replace(/stroke-width="2"/, 'stroke-width="1.75"');
---

<Fragment set:html={html} />
