---
/**
 * Layout da landing page, usado pelas versões do teste A/B e pelas páginas de nicho.
 * Os textos vêm de src/data/copy.ts (A/B) e src/data/nichos.ts (nichos); o layout é idêntico em todas.
 */
import Base, { type PageSeo } from '../layouts/Base.astro';
import ChatMock from './ChatMock.astro';
import CtaButton from './CtaButton.astro';
import Mascot from './Mascot.astro';
import Logo from './Logo.astro';
import OfferCard from './OfferCard.astro';
import OfferTicker from './OfferTicker.astro';
import SectionBg from './SectionBg.astro';
import SiteFooter from './SiteFooter.astro';
import { Image } from 'astro:assets';
import heroOfertas from '../assets/hero-ofertas.png';
import heroOfertasPerfumes from '../assets/hero-ofertas-perfumes.png';
import heroOfertasEletronicos from '../assets/hero-ofertas-eletronicos.png';
import heroOfertasMaquinas from '../assets/hero-ofertas-maquinas.png';
import { WHATSAPP_GROUP_URL } from '../config';
import { offers as defaultOffers, type Offer } from '../data/offers';
import type { PageCopy } from '../data/copy';
import type { ChatContent } from '../data/nichos';

interface Props {
  /** Identifica a página no Pixel, no Clarity e no link do grupo (a, b ou o nicho). */
  variante: string;
  copy: PageCopy;
  offers?: Offer[];
  grupoUrl?: string;
  chat?: ChatContent;
  /** Etiqueta da logo: FaroFino [Ofertas]. */
  marca?: string;
  seo?: PageSeo;
  /** Paleta de cores do nicho (src/styles/temas.css). */
  tema?: 'perfumes' | 'eletronicos' | 'maquinas';
}
const { variante, copy, offers = defaultOffers, grupoUrl = WHATSAPP_GROUP_URL, chat, marca, seo, tema } = Astro.props;

// Etiquetas da primeira dobra nas cores do nicho
const heroDeco = tema
  ? { perfumes: heroOfertasPerfumes, eletronicos: heroOfertasEletronicos, maquinas: heroOfertasMaquinas }[tema]
  : heroOfertas;

const mascotAlt = 'Mascote do FaroFino: cachorro caramelo detetive com chapéu xadrez e lupa';

const [featured, ...rest] = offers;
---

<Base variante={variante} seo={seo} tema={tema}>
  <main>
  <div class="top">
  <SectionBg name="hero" eager />
  <!-- Composição de etiquetas e selos de oferta (imagem decorativa gerada para a primeira dobra) -->
  <Image
    src={heroDeco}
    alt=""
    widths={[800, 1200, 1800]}
    sizes="(min-width: 960px) 100vw, 120vw"
    loading="eager"
    class="hero__deco"
    data-parallax
  />
  <header class="site-header">
    <div class="container">
      <Logo tag={marca} />
    </div>
  </header>

    <!-- 1. Primeira dobra (o fundo fica no wrapper .top, junto com o cabeçalho) -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero__grid">
        <div class="hero__text">
          <Mascot
            widths={[80, 160]}
            sizes="80px"
            mirror
            react
            loading="eager"
            alt={mascotAlt}
            class="hero__mascot-mobile"
          />
          <h1 id="hero-title" class="hero__title">
            {copy.hero.titulo} <span class="mark">{copy.hero.destaque}</span>
          </h1>
          <p class="hero__sub">{copy.hero.subtitulo}</p>
          <div class="hero__cta">
            <CtaButton secao="hero" label={copy.hero.botao} href={grupoUrl} />
            <p class="hero__note">{copy.hero.nota}</p>
          </div>
        </div>
        <div class="hero__art">
          <Mascot
            widths={[240, 420, 486]}
            sizes="420px"
            mirror
            sway
            react
            loading="eager"
            priority
            alt={mascotAlt}
            class="hero__mascot"
          />
        </div>
      </div>
      <OfferTicker offers={offers} href={grupoUrl} />
    </section>
  </div>

    <!-- 2. Como funciona -->
    <section class="how" aria-labelledby="como-funciona">
      <SectionBg name="como-funciona" />
      <div class="container how__grid">
        <div class="how__text">
          <h2 id="como-funciona" class="title-xl">{copy.comoFunciona.titulo}</h2>
          <ol class="how__steps" role="list">
            {
              copy.comoFunciona.passos.map((step, i) => (
                <li class="how__step" data-reveal>
                  <span class="how__num" aria-hidden="true">
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="how__step-title">{step.titulo}</h3>
                    <p>{step.texto}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="how__phone">
          <ChatMock chat={chat} />
        </div>
      </div>
    </section>

    <!-- 3. Sem mistério -->
    <section class="trust" aria-labelledby="sem-misterio">
      <SectionBg name="sem-misterio" />
      <Mascot widths={[200, 320]} sizes="(min-width: 960px) 320px, 170px" react class="trust__mascot" />
      <div class="container trust__grid">
        <div class="trust__main">
          <h2 id="sem-misterio" class="title-xl">{copy.transparencia.titulo}</h2>
          <p class="trust__text">{copy.transparencia.texto}</p>
        </div>
        <ul class="trust__list" role="list">
          {
            copy.transparencia.pontos.map((point) => (
              <li class="trust__item" data-reveal>
                <h3 class="trust__item-title">{point.titulo}</h3>
                <p>{point.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 4. Vitrine -->
    <section class="showcase-section" aria-labelledby="vitrine">
      <SectionBg name="vitrine" />
      <div class="container">
        <div class="showcase__head">
          <h2 id="vitrine" class="title-xl">{copy.vitrine.titulo}</h2>
          <p class="showcase__aside">{copy.vitrine.nota}</p>
        </div>
        <ul class="showcase" role="list">
          <li class="showcase__featured" data-reveal>
            <OfferCard offer={featured} secao="vitrine" variant="featured" href={grupoUrl} />
          </li>
          {
            rest.map((offer) => (
              <li data-reveal>
                <OfferCard offer={offer} secao="vitrine" href={grupoUrl} />
              </li>
            ))
          }
        </ul>
        <div class="showcase__cta">
          <CtaButton secao="vitrine" label={copy.vitrine.botao} href={grupoUrl} />
        </div>
      </div>
    </section>

    <!-- 5. Perguntas frequentes -->
    <section class="faq-section" aria-labelledby="faq">
      <SectionBg name="faq" />
      <div class="container faq__grid">
        <h2 id="faq" class="title-xl faq__title">{copy.faq.titulo}</h2>
        <div class="faq">
          {
            copy.faq.itens.map((item) => (
              <details class="faq__item" data-reveal>
                <summary>
                  <span>{item.q}</span>
                  <span class="faq__icon" aria-hidden="true">
                    +
                  </span>
                </summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 6. Chamada final -->
    <section class="final" aria-labelledby="final-title">
      <SectionBg name="final" />
      <div class="container final__grid">
        <div class="final__text">
          <h2 id="final-title" class="final__title">{copy.final.titulo}</h2>
          <p class="final__sub">{copy.final.subtitulo}</p>
          <CtaButton secao="final" label={copy.final.botao} href={grupoUrl} />
        </div>
      </div>
      <Mascot
        widths={[240, 400, 486]}
        sizes="(min-width: 960px) 400px, 220px"
        mirror
        react
        alt={mascotAlt}
        class="final__mascot"
      />
    </section>
  </main>

  <SiteFooter tag={marca} />
</Base>
