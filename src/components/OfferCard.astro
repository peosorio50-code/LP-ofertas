---
import { WHATSAPP_GROUP_URL } from '../config';
import { formatPrice, type Offer } from '../data/offers';
import downloadedPhotos from '../data/offer-photos.manifest.json';

interface Props {
  offer: Offer;
  secao: 'hero' | 'vitrine';
  variant?: 'compact' | 'grid' | 'featured';
  loading?: 'eager' | 'lazy';
  /** Cópia decorativa (usada para o loop infinito do carrossel). */
  duplicate?: boolean;
}
const { offer, secao, variant = 'grid', loading = 'lazy', duplicate = false } = Astro.props;

// Foto real (campo imagem) > foto de exemplo baixada no build > placeholder neutro
const photo = offer.imagem || ((downloadedPhotos as string[]).includes(offer.id) ? `/ofertas/${offer.id}.jpg` : '');
---

<a
  class:list={['offer', `offer--${variant}`]}
  href={WHATSAPP_GROUP_URL}
  target="_blank"
  rel="noopener noreferrer"
  data-cta={secao}
  data-elemento="card"
  data-oferta={offer.id}
  tabindex={duplicate ? -1 : undefined}
  data-tilt={variant === 'compact' ? undefined : ''}
>
  <div class="offer__media">
    {
      photo ? (
        <img
          src={photo}
          alt={duplicate ? '' : offer.titulo}
          width="480"
          height="480"
          loading={loading}
          decoding="async"
        />
      ) : (
        // Placeholder de exemplo: trocar pela foto real do produto em src/data/offers.ts
        <span class="offer__placeholder" aria-hidden="true">
          {offer.titulo}
        </span>
      )
    }
    <span class="offer__badge">
      <span aria-hidden="true">-{offer.desconto}%</span>
      <span class="sr-only">{offer.desconto}% de desconto</span>
    </span>
  </div>
  <div class="offer__body">
    <p class="offer__title">{offer.titulo}</p>
    <p class="offer__prices">
      <s class="offer__old"><span class="sr-only">De </span>{formatPrice(offer.precoAntigo)}</s>
      <strong class="offer__new"><span class="sr-only">por </span>{formatPrice(offer.precoAtual)}</strong>
    </p>
    <p class="offer__store"><span class="sr-only">Loja: </span>{offer.loja}</p>
  </div>
  <span class="sr-only">. Toque para entrar no grupo do WhatsApp (abre em uma nova aba).</span>
</a>
