---
import { offers as defaultOffers, type Offer } from '../data/offers';
import { WHATSAPP_GROUP_URL } from '../config';
import OfferCard from './OfferCard.astro';

interface Props {
  offers?: Offer[];
  href?: string;
}
const { offers = defaultOffers, href = WHATSAPP_GROUP_URL } = Astro.props;
---

<section class="ticker" aria-label="Exemplos de ofertas que chegam no grupo" data-ticker>
  <ul class="ticker__track" role="list">
    {
      offers.map((offer, i) => (
        <li class="ticker__item">
          <OfferCard offer={offer} secao="hero" variant="compact" loading={i < 3 ? 'eager' : 'lazy'} href={href} />
        </li>
      ))
    }
    {
      offers.map((offer) => (
        <li class="ticker__item ticker__item--clone" aria-hidden="true">
          <OfferCard offer={offer} secao="hero" variant="compact" loading="lazy" duplicate href={href} />
        </li>
      ))
    }
  </ul>
</section>

<script>
  // Pausa o carrossel enquanto o usuário toca nele (no mouse, o :hover do CSS já pausa).
  document.querySelectorAll<HTMLElement>('[data-ticker]').forEach((ticker) => {
    let resumeTimer: number | undefined;
    const pause = () => {
      window.clearTimeout(resumeTimer);
      ticker.classList.add('is-paused');
    };
    const resumeSoon = () => {
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => ticker.classList.remove('is-paused'), 2000);
    };
    ticker.addEventListener('touchstart', pause, { passive: true });
    ticker.addEventListener('touchend', resumeSoon, { passive: true });
    ticker.addEventListener('touchcancel', resumeSoon, { passive: true });
  });
</script>
