---
/**
 * Fundo de seção: foto (quando existir) + camada de degradê por cima.
 *
 * Para usar uma foto, salve o arquivo em src/assets/fundos/ com o nome da seção
 * (ex.: hero.jpg, como-funciona.jpg, sem-misterio.jpg, final.jpg).
 * Sem foto, a seção mostra só o degradê.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/fundos/*.{jpg,jpeg,png,webp}', {
  eager: true,
});

interface Props {
  name: 'hero' | 'como-funciona' | 'sem-misterio' | 'vitrine' | 'faq' | 'final';
  eager?: boolean;
}
const { name, eager = false } = Astro.props;

const photo = Object.entries(photos).find(([path]) => path.split('/').pop()?.replace(/\.\w+$/, '') === name)?.[1]
  .default;
---

{
  photo && (
    <Image
      src={photo}
      alt=""
      widths={[640, 1280, 1920]}
      sizes="100vw"
      loading={eager ? 'eager' : 'lazy'}
      class="bg__photo"
    />
  )
}
<span class:list={['bg__overlay', `bg__overlay--${name}`, { 'bg__overlay--photo': photo }]} aria-hidden="true"></span>
