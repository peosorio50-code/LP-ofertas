---
import '../styles/global.css';
import { PAGE_DESCRIPTION, PAGE_TITLE, SITE_NAME, SITE_URL } from '../config';

const canonical = new URL('/', SITE_URL).toString();
const ogImage = new URL('/og-image.jpg', SITE_URL).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{PAGE_TITLE}</title>
    <meta name="description" content={PAGE_DESCRIPTION} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0E4D43" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / compartilhamento -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={PAGE_TITLE} />
    <meta property="og:description" content={PAGE_DESCRIPTION} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mascote do FaroFino Ofertas: um cachorro caramelo detetive com chapéu e lupa." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={PAGE_TITLE} />
    <meta name="twitter:description" content={PAGE_DESCRIPTION} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fontes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,800&family=Lilita+One&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap"
    />

    <!--
      ESPAÇO RESERVADO PARA ANALYTICS (ainda não instalado)
      - Meta Pixel: cole aqui o código base do Pixel (fbq('init', 'SEU_PIXEL_ID'); fbq('track', 'PageView');)
      - Google Analytics 4: cole aqui o gtag.js (gtag('config', 'G-XXXXXXX');)
      Os cliques nos botões já chamam fbq/gtag automaticamente quando existirem (ver src/lib/tracking.ts).
    -->
  </head>
  <body>
    <slot />
    <script>
      import { initTracking } from '../lib/tracking';
      import { initInteractions } from '../lib/interactions';
      initTracking();
      initInteractions();
    </script>
  </body>
</html>
