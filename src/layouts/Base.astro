---
import '../styles/global.css';
import { PAGE_DESCRIPTION, PAGE_TITLE, SITE_NAME, SITE_URL } from '../config';

export interface PageSeo {
  titulo: string;
  descricao: string;
  /** Caminho oficial da página (ex.: '/perfumes'). */
  caminho: string;
  /** Imagem de compartilhamento em /public (ex.: '/og-perfumes.jpg'). */
  ogImage: string;
  /** Nome que aparece na prévia de compartilhamento. */
  nome: string;
}

interface Props {
  /** Versão/nicho da página (vai para o Pixel, o Clarity e o link do grupo): a, b, perfumes... */
  variante?: string;
  seo?: PageSeo;
}
const {
  variante = 'a',
  seo = {
    titulo: PAGE_TITLE,
    descricao: PAGE_DESCRIPTION,
    caminho: '/',
    ogImage: '/og-image.jpg',
    nome: SITE_NAME,
  },
} = Astro.props;

// A versão B do teste aponta para a mesma URL oficial da A, para o Google não ver conteúdo duplicado.
const canonical = new URL(seo.caminho, SITE_URL).toString();
const ogImage = new URL(seo.ogImage, SITE_URL).toString();
---

<!doctype html>
<html lang="pt-BR" data-variante={variante}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.titulo}</title>
    <meta name="description" content={seo.descricao} />
    <link rel="canonical" href={canonical} />
    {variante === 'b' && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0E4D43" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / compartilhamento -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={seo.nome} />
    <meta property="og:title" content={seo.titulo} />
    <meta property="og:description" content={seo.descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Mascote do ${seo.nome}: um cachorro caramelo detetive com chapéu e lupa.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.titulo} />
    <meta name="twitter:description" content={seo.descricao} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fontes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,800&family=Lilita+One&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap"
    />

    <!-- Meta Pixel Code (dois pixels: 1638497151060044 e 1374694161407898, um único PageView) -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1638497151060044');
      fbq('init', '1374694161407898');
      fbq('track', 'PageView');
    </script>
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=1638497151060044&ev=PageView&noscript=1"
      /></noscript
    >
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=1374694161407898&ev=PageView&noscript=1"
      /></noscript
    >
    <!-- End Meta Pixel Code -->

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "yujevhiyd8");
    </script>
    <script is:inline>
      // Marca no Clarity qual versão da página foi vista (filtro "variante" nas gravações)
      clarity('set', 'variante', document.documentElement.dataset.variante || 'a');
    </script>
    <!-- End Microsoft Clarity -->

    <!--
      Google Analytics 4 (ainda não instalado): cole aqui o gtag.js (gtag('config', 'G-XXXXXXX');)
      Os cliques nos botões já chamam fbq/gtag automaticamente quando existirem (ver src/lib/tracking.ts).
    -->
  </head>
  <body>
    <slot />
    <script>
      import { initTracking } from '../lib/tracking';
      import { initInteractions } from '../lib/interactions';
      initTracking();
      initInteractions();
    </script>
  </body>
</html>
