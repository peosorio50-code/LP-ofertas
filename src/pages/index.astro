---
import Base from '../layouts/Base.astro';
import ChatMock from '../components/ChatMock.astro';
import CtaButton from '../components/CtaButton.astro';
import Mascot from '../components/Mascot.astro';
import Logo from '../components/Logo.astro';
import OfferCard from '../components/OfferCard.astro';
import OfferTicker from '../components/OfferTicker.astro';
import SectionBg from '../components/SectionBg.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { Image } from 'astro:assets';
import heroOfertas from '../assets/hero-ofertas.png';
import { offers } from '../data/offers';

const mascotAlt = 'Mascote do FaroFino: cachorro caramelo detetive com chapéu xadrez e lupa';

const steps = [
  {
    title: 'Você entra no grupo',
    text: 'Um clique e pronto. Não pedimos nome, e-mail nem cadastro.',
  },
  {
    title: 'O FaroFino fareja',
    text: 'A gente monitora as lojas e separa só o que está com preço bom de verdade.',
  },
  {
    title: 'Você compra direto na loja',
    text: 'O link abre no site ou app oficial da loja. O pagamento e a entrega são com eles.',
  },
];

const trustPoints = [
  {
    title: 'Compra no site oficial',
    text: 'Você é levado direto pro Mercado Livre ou pra Shopee. A gente nunca pede seus dados de pagamento.',
  },
  {
    title: 'Lojas que você já conhece',
    text: 'Nada de loja desconhecida ou site estranho.',
  },
  {
    title: 'Garantia da loja',
    text: 'Troca, devolução e suporte seguem as regras da loja onde você comprou.',
  },
];

const faq = [
  { q: 'É grátis mesmo?', a: 'Sim. Entrar e ficar no grupo é 100% gratuito.' },
  {
    q: 'Vou pagar mais caro comprando pelo link?',
    a: 'Não. O preço é o mesmo do site. A comissão sai da loja, não do seu bolso.',
  },
  {
    q: 'O grupo vai lotar meu celular de mensagem?',
    a: 'Só o FaroFino posta, e só ofertas. Dá pra silenciar o grupo e olhar quando quiser.',
  },
  {
    q: 'Vocês são o Mercado Livre ou a Shopee?',
    a: 'Não. Somos um grupo independente que participa dos programas de afiliados dessas lojas.',
  },
  { q: 'Como saio do grupo?', a: 'É só sair pelo próprio WhatsApp, a qualquer momento.' },
];

const [featured, ...rest] = offers;
---

<Base>
  <main>
  <div class="top">
  <SectionBg name="hero" eager />
  <!-- Composição de etiquetas e selos de oferta (imagem decorativa gerada para a primeira dobra) -->
  <Image
    src={heroOfertas}
    alt=""
    widths={[800, 1200, 1800]}
    sizes="(min-width: 960px) 100vw, 120vw"
    loading="eager"
    class="hero__deco"
    data-parallax
  />
  <header class="site-header">
    <div class="container">
      <Logo />
    </div>
  </header>

    <!-- 1. Primeira dobra (o fundo fica no wrapper .top, junto com o cabeçalho) -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero__grid">
        <div class="hero__text">
          <Mascot
            widths={[80, 160]}
            sizes="80px"
            mirror
            react
            loading="eager"
            alt={mascotAlt}
            class="hero__mascot-mobile"
          />
          <h1 id="hero-title" class="hero__title">
            A gente fareja as melhores ofertas. <span class="mark">Você só recebe no WhatsApp.</span>
          </h1>
          <p class="hero__sub">
            Promoções de verdade do Mercado Livre e da Shopee, direto no seu celular. Grátis, sem cadastro e sem
            pegadinha.
          </p>
          <div class="hero__cta">
            <CtaButton secao="hero" />
            <p class="hero__note">Só o FaroFino posta no grupo. Você sai quando quiser.</p>
          </div>
        </div>
        <div class="hero__art">
          <Mascot
            widths={[240, 420, 486]}
            sizes="420px"
            mirror
            sway
            react
            loading="eager"
            priority
            alt={mascotAlt}
            class="hero__mascot"
          />
        </div>
      </div>
      <OfferTicker />
    </section>
  </div>

    <!-- 2. Como funciona -->
    <section class="how" aria-labelledby="como-funciona">
      <SectionBg name="como-funciona" />
      <div class="container how__grid">
        <div class="how__text">
          <h2 id="como-funciona" class="title-xl">Como funciona</h2>
          <ol class="how__steps" role="list">
            {
              steps.map((step, i) => (
                <li class="how__step" data-reveal>
                  <span class="how__num" aria-hidden="true">
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="how__step-title">{step.title}</h3>
                    <p>{step.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="how__phone">
          <ChatMock />
        </div>
      </div>
    </section>

    <!-- 3. Sem mistério -->
    <section class="trust" aria-labelledby="sem-misterio">
      <SectionBg name="sem-misterio" />
      <Mascot widths={[200, 320]} sizes="(min-width: 960px) 320px, 170px" react class="trust__mascot" />
      <div class="container trust__grid">
        <div class="trust__main">
          <h2 id="sem-misterio" class="title-xl">Sem mistério: como a gente ganha dinheiro?</h2>
          <p class="trust__text">
            Os links que mandamos são de programas de afiliados das próprias lojas. Quando você compra por eles, a
            loja paga uma pequena comissão pra gente. Você não paga nada a mais por isso: o preço é exatamente o
            mesmo do site.
          </p>
        </div>
        <ul class="trust__list" role="list">
          {
            trustPoints.map((point) => (
              <li class="trust__item" data-reveal>
                <h3 class="trust__item-title">{point.title}</h3>
                <p>{point.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 4. Vitrine -->
    <section class="showcase-section" aria-labelledby="vitrine">
      <SectionBg name="vitrine" />
      <div class="container">
        <div class="showcase__head">
          <h2 id="vitrine" class="title-xl">Olha o tipo de coisa que o FaroFino encontra</h2>
          <p class="showcase__aside">
            Isso aqui é amostra. No grupo, o preço muda rápido e quem manda é a loja.
          </p>
        </div>
        <ul class="showcase" role="list">
          <li class="showcase__featured" data-reveal>
            <OfferCard offer={featured} secao="vitrine" variant="featured" />
          </li>
          {
            rest.map((offer) => (
              <li data-reveal>
                <OfferCard offer={offer} secao="vitrine" />
              </li>
            ))
          }
        </ul>
        <div class="showcase__cta">
          <CtaButton secao="vitrine" label="Quero receber ofertas assim" />
        </div>
      </div>
    </section>

    <!-- 5. Perguntas frequentes -->
    <section class="faq-section" aria-labelledby="faq">
      <SectionBg name="faq" />
      <div class="container faq__grid">
        <h2 id="faq" class="title-xl faq__title">Perguntas frequentes</h2>
        <div class="faq">
          {
            faq.map((item) => (
              <details class="faq__item" data-reveal>
                <summary>
                  <span>{item.q}</span>
                  <span class="faq__icon" aria-hidden="true">
                    +
                  </span>
                </summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 6. Chamada final -->
    <section class="final" aria-labelledby="final-title">
      <SectionBg name="final" />
      <div class="container final__grid">
        <div class="final__text">
          <h2 id="final-title" class="final__title">Bora economizar?</h2>
          <p class="final__sub">O próximo achado pode ser aquela coisa que tá no seu carrinho faz um mês.</p>
          <CtaButton secao="final" />
        </div>
      </div>
      <Mascot
        widths={[240, 400, 486]}
        sizes="(min-width: 960px) 400px, 220px"
        mirror
        react
        alt={mascotAlt}
        class="final__mascot"
      />
    </section>
  </main>

  <SiteFooter />
</Base>
