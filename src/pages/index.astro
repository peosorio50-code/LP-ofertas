---
import { Image } from 'astro:assets';
import { MessageCirclePlus, PackageCheck, Plus, ScanSearch, ShieldCheck, ShoppingBag, Store } from 'lucide-static';
import Base from '../layouts/Base.astro';
import CtaButton from '../components/CtaButton.astro';
import Icon from '../components/Icon.astro';
import OfferCard from '../components/OfferCard.astro';
import OfferTicker from '../components/OfferTicker.astro';
import { offers } from '../data/offers';
import mascote from '../assets/mascote.png';

const mascotAlt = 'Mascote do FaroFino: cachorro caramelo detetive com chapéu xadrez e lupa';

const steps = [
  {
    icon: MessageCirclePlus,
    title: 'Você entra no grupo',
    text: 'Um clique e pronto. Não pedimos nome, e-mail nem cadastro.',
  },
  {
    icon: ScanSearch,
    title: 'O FaroFino fareja',
    text: 'A gente monitora as lojas e separa só o que está com preço bom de verdade.',
  },
  {
    icon: ShoppingBag,
    title: 'Você compra direto na loja',
    text: 'O link abre no site ou app oficial da loja. O pagamento e a entrega são com eles.',
  },
];

const trustPoints = [
  {
    icon: ShieldCheck,
    title: 'Compra no site oficial',
    text: 'Você é levado direto pro Mercado Livre ou pra Shopee. A gente nunca pede seus dados de pagamento.',
  },
  {
    icon: Store,
    title: 'Lojas que você já conhece',
    text: 'Nada de loja desconhecida ou site estranho.',
  },
  {
    icon: PackageCheck,
    title: 'Garantia da loja',
    text: 'Troca, devolução e suporte seguem as regras da loja onde você comprou.',
  },
];

const faq = [
  { q: 'É grátis mesmo?', a: 'Sim. Entrar e ficar no grupo é 100% gratuito.' },
  {
    q: 'Vou pagar mais caro comprando pelo link?',
    a: 'Não. O preço é o mesmo do site. A comissão sai da loja, não do seu bolso.',
  },
  {
    q: 'O grupo vai lotar meu celular de mensagem?',
    a: 'Só o FaroFino posta, e só ofertas. Dá pra silenciar o grupo e olhar quando quiser.',
  },
  {
    q: 'Vocês são o Mercado Livre ou a Shopee?',
    a: 'Não. Somos um grupo independente que participa dos programas de afiliados dessas lojas.',
  },
  { q: 'Como saio do grupo?', a: 'É só sair pelo próprio WhatsApp, a qualquer momento.' },
];
---

<Base>
  <header class="site-header">
    <div class="container">
      <span class="brand">
        <Image src={mascote} alt="" width={36} densities={[1, 2]} loading="eager" class="brand__logo" />
        <span class="brand__name">FaroFino Ofertas</span>
      </span>
    </div>
  </header>

  <main>
    <!-- 1. Primeira dobra -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero__grid">
        <div class="hero__art">
          <Image
            src={mascote}
            alt={mascotAlt}
            widths={[72, 144, 216, 360, 486]}
            sizes="(min-width: 960px) 360px, 72px"
            loading="eager"
            fetchpriority="high"
            class="hero__mascot"
          />
        </div>
        <div class="hero__text">
          <h1 id="hero-title" class="hero__title">
            A gente fareja as melhores ofertas. <span class="mark">Você só recebe no WhatsApp.</span>
          </h1>
          <p class="hero__sub">
            Promoções de verdade do Mercado Livre e da Shopee, direto no seu celular. Grátis, sem cadastro e sem
            pegadinha.
          </p>
          <div class="hero__cta">
            <CtaButton secao="hero" />
            <p class="hero__note">Só o FaroFino posta no grupo. Você sai quando quiser.</p>
          </div>
        </div>
      </div>
      <OfferTicker />
    </section>

    <!-- 2. Como funciona -->
    <section class="section" aria-labelledby="como-funciona">
      <div class="container">
        <h2 id="como-funciona" class="section__title">Como funciona</h2>
        <ol class="steps" role="list">
          {
            steps.map((step, i) => (
              <li class="card step">
                <span class="step__icon">
                  <Icon svg={step.icon} size={28} />
                </span>
                <span class="step__num" aria-hidden="true">
                  {i + 1}
                </span>
                <h3 class="card__title">{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 3. Sem mistério -->
    <section class="section trust" aria-labelledby="sem-misterio">
      <div class="container">
        <div class="trust__intro">
          <h2 id="sem-misterio" class="section__title">Sem mistério: como a gente ganha dinheiro?</h2>
          <p class="trust__text">
            Os links que mandamos são de programas de afiliados das próprias lojas. Quando você compra por eles, a
            loja paga uma pequena comissão pra gente. Você não paga nada a mais por isso: o preço é exatamente o
            mesmo do site.
          </p>
        </div>
        <ul class="trust__grid" role="list">
          {
            trustPoints.map((point) => (
              <li class="card trust__card">
                <span class="step__icon">
                  <Icon svg={point.icon} size={28} />
                </span>
                <h3 class="card__title">{point.title}</h3>
                <p>{point.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 4. Vitrine -->
    <section class="section" aria-labelledby="vitrine">
      <div class="container">
        <h2 id="vitrine" class="section__title">Olha o tipo de coisa que o FaroFino encontra</h2>
        <ul class="showcase" role="list">
          {
            offers.map((offer) => (
              <li>
                <OfferCard offer={offer} secao="vitrine" />
              </li>
            ))
          }
        </ul>
        <div class="section__cta">
          <CtaButton secao="vitrine" label="Quero receber ofertas assim" />
        </div>
      </div>
    </section>

    <!-- 5. Perguntas frequentes -->
    <section class="section section--faq" aria-labelledby="faq">
      <div class="container container--narrow">
        <h2 id="faq" class="section__title">Perguntas frequentes</h2>
        <div class="faq">
          {
            faq.map((item) => (
              <details class="faq__item">
                <summary>
                  <span>{item.q}</span>
                  <Icon svg={Plus} size={22} class="faq__icon" />
                </summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 6. Chamada final -->
    <section class="final" aria-labelledby="final-title">
      <div class="container final__inner">
        <Image
          src={mascote}
          alt={mascotAlt}
          widths={[140, 280]}
          sizes="140px"
          loading="lazy"
          class="final__mascot"
        />
        <h2 id="final-title" class="final__title">Bora economizar?</h2>
        <CtaButton secao="final" />
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <p class="site-footer__brand">FaroFino Ofertas © 2026</p>
      <p class="site-footer__legal">
        O FaroFino Ofertas é um grupo independente e não tem vínculo com Mercado Livre, Shopee ou outras lojas
        citadas, além da participação em seus programas de afiliados. Preços e disponibilidade podem mudar a
        qualquer momento e são definidos pelas lojas.
      </p>
    </div>
  </footer>
</Base>
